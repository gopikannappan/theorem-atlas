      "name": "IMO2025P2Coordinates.circle_difference",
      "assumptions": [
        "r,R,d,x,y:Real",
        "x²+y²=r²",
        "(x-d)²+y²=R²"
      ],
      "conclusion": "2dx=d²+r²-R²"
    },
    {
      "name": "IMO2025P2Coordinates.circle_height_identity",
      "assumptions": [
        "r,R,d,x,y:Real",
        "x²+y²=r²",
        "(x-d)²+y²=R²"
      ],
      "conclusion": "4d²y²=(d+R+r)(R+r-d)(d²-(R-r)²)"
    },
    {
      "name": "IMO2025P2Coordinates.circumcenter_coordinates",
      "assumptions": [
        "r,R,d>0",
        "y≠0",
        "A lies on the two normalized circles",
        "P has equal squared distances to A,C,D, with C=(-r,0), D=(d+R,0)"
      ],
      "conclusion": "2p=d+R-r and (R+r-d)q=-dy"
    },
    {
      "name": "IMO2025P2Coordinates.normalized_line_factorization",
      "assumptions": [
        "d,y,d+V,V-d all nonzero",
        "4d²y²=(d+V)(V-d)(d²-U²)"
      ],
      "conclusion": "Candidate circle polynomial along candidate line equals ((V²-U²)/4)(d+V)/(V-d)(t-(V-d)/(d+V))²"
    },
    {
      "name": "IMO2025P2Coordinates.normalized_unique_parameter",
      "assumptions": [
        "All factorization assumptions",
        "V²-U²≠0"
      ],
      "conclusion": "Candidate polynomial along candidate line vanishes iff t=(V-d)/(d+V)"
    }
  ],
